@page "/users"

@using RealEstate.Frontend.Models
@inject ApiHandler ApiHandler

<PageTitle>Users</PageTitle>

<h3>Users</h3>

<hr/>

@if (users is null)
{
    <p>
        <em>Loading users...</em>
    </p>
}
else if (users.Data is null || users.Data.Count == 0)
{
    <div class="alert alert-info">
        No users found
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Created</th>
        </tr>
        </thead>
        
        <tbody>
        @foreach (var user in users.Data!)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        </tbody>
    </table>
}

@code
{
    //List loaded from the API
    private ApiResponse<List<UserDto>>? users;

    protected override async Task OnInitializedAsync()
    {
        //Call GET /api/Users
        users =
            await ApiHandler.GetAsync<ApiResponse<List<UserDto>>>(
                ApiEndpoints.Users);
    }
}
